# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Downloadable dataset (src/data/download_dataset.py fetches it)
data/raw/

# Generated preprocessing artifacts (src/features/preprocess.py regenerates
# every split, position file, .npz and the scaler/pipeline from data/raw)
data/processed/

# Trained models + pipeline artifacts (src/models/random_forest.py and
# src/models/lstm_model.py regenerate them; preprocess.py writes the
# scaler/pipeline/metadata here too)
models/

# Runtime artifacts (regenerated by the simulator/API)
reports/*.sqlite
